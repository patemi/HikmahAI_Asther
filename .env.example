# Database
DATABASE_URL=postgresql://astheron:change-me-database-password@localhost:5435/asther
POSTGRES_USER=astheron
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_DB=asther

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Models
LLM_MODEL=gemini-3.8-flash
# Embeddings are 1024-dim. Models named voyage-* use VOYAGE_API_KEY; gemini-* use GEMINI_API_KEY.
EMBEDDING_MODEL=voyage-4
VOYAGE_API_KEY=your-voyage-api-key-here

# Auth
DEFAULT_USERNAME=asther
DEFAULT_PASSWORD=replace-with-a-unique-password-12-chars
SESSION_SECRET=your-random-session-secret-here

# API
BEARER_TOKEN=your-bearer-token-here
APP_URL=http://localhost:3000
# LLM_API_BASE=https://your-provider.example/v1
MEMORY_LENGTH=5

# Security
CORS_ORIGIN=http://localhost:3000

# Shared usage limits (PostgreSQL-backed)
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100
MODEL_REQUESTS_PER_DAY=2000
MODEL_TOKENS_PER_DAY=500000
# Separate daily budget for knowledge indexing (embedding documents); tokens are estimated from characters
INDEX_REQUESTS_PER_DAY=5000
INDEX_TOKENS_PER_DAY=100000000

# Enable only behind a proxy that overwrites client IP headers
TRUST_PROXY=false

# 0 preserves conversations until explicitly deleted
CHAT_RETENTION_DAYS=0
